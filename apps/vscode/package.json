{
  "name": "event-storming-modeler",
  "private": true,
  "version": "0.1.0",
  "displayName": "Event Storming Modeler",
  "description": "View and edit Event Storming boards directly in VS Code, backed by plain-text .storm files.",
  "publisher": "miragon-gmbh",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Miragon/event-storming-modeler.git",
    "directory": "apps/vscode"
  },
  "bugs": "https://github.com/Miragon/event-storming-modeler/issues",
  "homepage": "https://github.com/Miragon/event-storming-modeler/tree/main/apps/vscode#readme",
  "license": "MIT",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "event storming",
    "DDD",
    "domain-driven design",
    "workshop",
    "modeling"
  ],
  "main": "./dist/extension.cjs",
  "type": "module",
  "activationEvents": [
    "onCustomEditor:eventStorming.boardEditor"
  ],
  "contributes": {
    "languages": [
      {
        "id": "event-storming-dsl",
        "aliases": [
          "Event Storming DSL"
        ],
        "extensions": [
          ".storm"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "customEditors": [
      {
        "viewType": "eventStorming.boardEditor",
        "displayName": "Event Storming Board",
        "selector": [
          {
            "filenamePattern": "*.storm"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "eventStorming.newBoard",
        "title": "New Empty Board",
        "category": "Event Storming",
        "shortTitle": "Event Storming Board"
      },
      {
        "command": "eventStorming.newBoardFromExample",
        "title": "New Board from Example",
        "category": "Event Storming"
      }
    ],
    "menus": {
      "file/newFile": [
        {
          "command": "eventStorming.newBoard",
          "group": "eventStorming"
        }
      ]
    },
    "walkthroughs": [
      {
        "id": "getStarted",
        "title": "Get Started with Event Storming",
        "description": "Event Storming is a workshop format for exploring a business domain with sticky notes: domain events, the commands that trigger them, and the people and systems involved. This extension lets you create and edit Event Storming boards in VS Code as plain-text .storm files.",
        "steps": [
          {
            "id": "create",
            "title": "Create your first board",
            "description": "Open a ready-made example board, or start from a blank canvas.\n[Create board from example](command:eventStorming.newBoardFromExample)",
            "media": {
              "markdown": "media/walkthrough/create.md"
            },
            "completionEvents": [
              "onCommand:eventStorming.newBoardFromExample",
              "onCommand:eventStorming.newBoard"
            ]
          },
          {
            "id": "learn",
            "title": "Learn the basics",
            "description": "Add stickies for events, commands and aggregates, connect them with arrows, then export the board as SVG or PNG.",
            "media": {
              "markdown": "media/walkthrough/learn.md"
            },
            "completionEvents": [
              "onStepSelected"
            ]
          }
        ]
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "typecheck": "tsc -p tsconfig.json",
    "vscode:prepublish": "node esbuild.config.mjs --production",
    "package": "vsce package --no-dependencies -o event-storming-modeler.vsix"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@miragon/event-storming-dsl": "0.1.0",
    "@miragon/event-storming-renderer": "0.1.0",
    "@miragon/event-storming-schema-model": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "@types/vscode": "1.96.0",
    "@vscode/vsce": "3.9.2",
    "esbuild": "0.28.2",
    "typescript": "6.0.3"
  }
}
